// General
// ============================================================================

$hue: (
{% for group_name, group in colors %}
{% set last_group = loop.last %}
    // {{ group_name }}
    // ------------------------------------------------------------------------
{% for color_name, color in group %}
    {{ color_name }}: {{ color.srgb() }}{{ "" if (last_group and loop.last) else "," }}
{% endfor %}
{% endfor %}
);
